# Copy this file outside the repository, replace every required value, and pass it with
# `docker compose --env-file <path> -f compose.production.yml up -d`.

AEGIS_PUBLIC_ORIGIN=https://aegis.example.com
AEGIS_HTTP_PORT=8080
AEGIS_MODE=TESTNET
AEGIS_IMAGE_PREFIX=ghcr.io/eshaanvgupta/aegis-counterfactual

# Generate independent values with at least 32 random bytes each. Never reuse them.
AEGIS_OWNER_TOKEN=replace-with-an-independent-64-character-secret
AEGIS_VERIFIER_TOKEN=replace-with-an-independent-64-character-secret

NEAR_NETWORK_ID=testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com,https://rpc.testnet.near.org
NEAR_VAULT_ID=vault.example.testnet
NEAR_OWNER_ID=owner.example.testnet
NEAR_AGENT_ID=agent.example.testnet
NEAR_ATTESTOR_ID=attestor.example.testnet
NEAR_RECIPIENT_ID=recipient.example.testnet

# Supply only the role-specific key to each container through Compose interpolation.
NEAR_OWNER_PRIVATE_KEY=ed25519:replace-with-owner-testnet-key
NEAR_AGENT_PRIVATE_KEY=ed25519:replace-with-agent-testnet-key
NEAR_ATTESTOR_PRIVATE_KEY=ed25519:replace-with-attestor-testnet-key

# Offline is deterministic and incurs no inference cost. Remote providers remain opt-in.
LLM_PROVIDER=offline
LLM_MODEL=
LLM_API_KEY=
AEGIS_ALLOW_PAID_LLM=false

