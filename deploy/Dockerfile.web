FROM node:24-bookworm-slim AS builder

RUN corepack enable && corepack prepare pnpm@11.25.0 --activate
WORKDIR /app
COPY . .

ARG AEGIS_AGENT_API=http://agent:8000
ARG AEGIS_OWNER_API=http://owner:8002
ENV AEGIS_AGENT_API=${AEGIS_AGENT_API} \
    AEGIS_OWNER_API=${AEGIS_OWNER_API} \
    AEGIS_STANDALONE=1 \
    NEXT_TELEMETRY_DISABLED=1

RUN pnpm install --frozen-lockfile && pnpm build

FROM node:24-bookworm-slim AS runner

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    HOSTNAME=0.0.0.0 \
    PORT=3000

RUN useradd --uid 10001 --create-home --shell /usr/sbin/nologin aegis
WORKDIR /app

COPY --from=builder --chown=aegis:aegis /app/apps/web/.next/standalone ./
COPY --from=builder --chown=aegis:aegis /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder --chown=aegis:aegis /app/apps/web/public ./apps/web/public

USER aegis
EXPOSE 3000
CMD ["node", "apps/web/server.js"]

