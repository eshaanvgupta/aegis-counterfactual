# AEGIS // COUNTERFACTUAL — copy to .env only if you need to override defaults.
# Defaults are safe: local simulation, no chain signing, no paid inference.
# NEVER paste mainnet keys. NEVER commit .env.

# ── Mode ─────────────────────────────────────────────────────────────
# LOCAL_SIMULATION (default for `pnpm dev`) or TESTNET (set by `pnpm dev:testnet`).
AEGIS_MODE=LOCAL_SIMULATION
AEGIS_DB=runtime/aegis.sqlite3
AEGIS_WEB_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Bearer tokens for the local owner console and the verifier. `pnpm dev` generates random
# ones when empty and writes the owner token to runtime/owner-token.txt (git-ignored).
AEGIS_OWNER_TOKEN=
AEGIS_VERIFIER_TOKEN=

# ── Optional LLM for the transaction agent ───────────────────────────
# offline (default, deterministic, no network) | ollama | openai | openrouter | nearai
# The model never decides authorization; it only proposes. Paid providers are refused
# unless AEGIS_ALLOW_PAID_LLM=true is set explicitly by a human.
LLM_PROVIDER=offline
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_MS=15000
AEGIS_ALLOW_PAID_LLM=false

# ── NEAR testnet ─────────────────────────────────────────────────────
# Preferred: `pnpm testnet:provision` creates disposable faucet-funded identities in
# runtime/dev-credentials (git-ignored). Use the variables below only to bring your own
# testnet accounts. Each service process receives exactly ONE of these keys.
NEAR_NETWORK_ID=testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com
NEAR_VAULT_ID=
NEAR_OWNER_ID=
NEAR_AGENT_ID=
NEAR_ATTESTOR_ID=
NEAR_RECIPIENT_ID=
NEAR_OWNER_PRIVATE_KEY=
NEAR_AGENT_PRIVATE_KEY=
NEAR_ATTESTOR_PRIVATE_KEY=
NEAR_VAULT_PRIVATE_KEY=
